# Copy to terraform.tfvars — this file is safe to commit, terraform.tfvars is gitignored

aws_region         = "us-east-1"
project            = "foodflow"
key_pair_name      = "foodflow-key"          # create in AWS Console → EC2 → Key Pairs
openrouter_api_key = "sk-or-v1-..."          # openrouter.ai → Keys
nemotron_api_key   = ""                      # build.nvidia.com → optional Tier 0
app_url            = "https://foodflow-ai.vercel.app"
